# Block access to dotfiles (.env, .git, etc.)
<Files .*>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files from public/ transparently (CSS, JS, images, fonts)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Serve real directories from public/ transparently
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Anything else under these application directories is never meant to be
    # requested directly - block before falling through to Apache's default
    # static-file serving, which would otherwise expose source/config/logs.
    RewriteRule ^(app|bootstrap|config|database|packages|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Route all other requests through the root index.php (fixes SCRIPT_NAME)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
