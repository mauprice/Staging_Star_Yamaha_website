{
    "name": "honda/catalog",
    "description": "Installable Laravel package that scrapes and normalises Honda AU motorcycle catalog data (content, specs, pricing, colours/variants, digital assets).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "honda", "catalog", "scraper"],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/dom-crawler": "^6.0|^7.0|^8.0",
        "symfony/css-selector": "^6.0|^7.0|^8.0",
        "spatie/laravel-package-tools": "^1.9"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Honda\\Catalog\\": "src/",
            "Honda\\Catalog\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Honda\\Catalog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Honda\\Catalog\\HondaCatalogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
